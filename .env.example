# ==============================================================================
# PayGuard Environment Configuration Template
# Copy this file to .env and fill in your actual environment values.
# Do NOT commit .env with real credentials into source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=your_postgres_password_here

# Spring Boot Datasource Configuration
PAYGUARD_DB_URL=jdbc:postgresql://localhost:5433/payguard
PAYGUARD_DB_USERNAME=payguard
PAYGUARD_DB_PASSWORD=your_db_password_here

# JWT Security Configuration
# Must be at least 32 characters long for HMAC-SHA signing
PAYGUARD_JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_here

# Application Configuration
PAYGUARD_BUSINESS_ZONE=Asia/Kolkata
PAYGUARD_ML_BASE_URL=http://localhost:8001

# Initial Admin User Seed Configuration
PAYGUARD_ADMIN_USERNAME=admin
PAYGUARD_ADMIN_PASSWORD=your_admin_password_here
PAYGUARD_ADMIN_EMAIL=admin@example.com

# Simulator Configuration (optional)
API_BASE_URL=http://localhost:8080
SIMULATOR_USERNAME=admin
SIMULATOR_PASSWORD=your_simulator_password_here
